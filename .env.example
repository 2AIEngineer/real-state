# ===========================================================================
# CORE 
# ===========================================================================
# development | test | production (anything else stops the start-up)
ENVIRONMENT=development
# Production: at least 50 characters
SECRET_KEY=change-me
DEBUG=true
GUNICORN_WORKERS=
GUNICORN_THREADS=2
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
SITE_URL=http://localhost:5173/
# E-mail branding (defaults shown)
BRAND_NAME=Urbis
BRAND_LOGO_URL=https://urbisapp.com/logo.png
BRAND_DASHBOARD_URL=https://app-urbis.com/account/login
BRAND_WEBSITE_URL=https://urbisapp.com/fr
DJANGO_SUPERUSER_EMAIL=you@example.com
DJANGO_SUPERUSER_PASSWORD=yourpassword

# ===========================================================================
# LOCAL DATABASE
# ===========================================================================
POSTGRES_DB=your_database_name
POSTGRES_USER=your_database_user
POSTGRES_PASSWORD=your_database_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
 

# ===========================================================================
# FILES (required in production: a PRIVATE Azure Blob container)
# ===========================================================================
AZURE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=change-me;AccountKey=change-me;EndpointSuffix=core.windows.net
AZURE_CONTAINER=your_container_name

# ===========================================================================
# REDIS_URL=redis://localhost:6379/0

# ===========================================================================
# EMAIL (SMTP)
# ===========================================================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_email_password

# ===========================================================================
# NOTIFICATIONS
# ===========================================================================
ENABLED_EMAIL_NOTIFICATION=true
ENABLED_PUSH_NOTIFICATION=true
EXPO_ACCESS_TOKEN=
NOTIFICATIONS_DELIVER_ON_COMMIT=false

# ===========================================================================
# JWT
# ===========================================================================
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=14
# Production: required, at least 32 characters
# JWT_SIGNING_KEY=

# ===========================================================================
# OPTIONAL (defaults shown)
# ===========================================================================
# LOG_LEVEL=INFO
# TIME_ZONE=UTC
# MEDIA_ROOT=media                     # local files (development only)
# CSRF_TRUSTED_ORIGINS=
# SECURE_SSL_REDIRECT=true
# POSTGRES_CONN_MAX_AGE=60
# POSTGRES_SSLMODE=prefer
# PASSWORD_RESET_TIMEOUT=259200        # invitation link (72 h)
# PASSWORD_RESET_LINK_TIMEOUT=7200     # reset link of an account in use (2 h)
# NUM_PROXIES=1                        # proxies appending to X-Forwarded-For (1 in production)
# AUTH_THROTTLE_RATE=20/min            # per address, authentication endpoints
# LOGIN_THROTTLE_RATE=10/min           # per account, login
# ANON_THROTTLE_RATE=60/min
# USER_THROTTLE_RATE=600/min
# DEFAULT_FROM_EMAIL=
# EMAIL_USE_TLS=true
# EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send
# OUTBOX_MAX_ATTEMPTS=6
# OUTBOX_BATCH_SIZE=50
# OUTBOX_RETENTION_DAYS=30
# DJANGO_SUPERUSER_FIRST_NAME=
# DJANGO_SUPERUSER_LAST_NAME=
